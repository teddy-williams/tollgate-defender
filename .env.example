# Copy to .env. Never commit .env (it is git-ignored). Use long random values: openssl rand -hex 32

# --- required -------------------------------------------------------------------------------------------
TOLLGATE_TRACER_TOKEN=

# --- your owner ("master") account ------------------------------------------------------------------------
# Preferred: leave these empty and run:  docker compose run --rm cli user create-master YOUR-USERNAME
# (it asks for the password, so it never sits in a file).
# Convenience alternative: fill both in, start Tollgate once, sign in, you will be forced to choose a new
# password immediately. Then DELETE the password from this file.
TOLLGATE_MASTER_USERNAME=
TOLLGATE_MASTER_PASSWORD=

# --- threat feeds (optional) ------------------------------------------------------------------------------
# Your abuse.ch Auth-Key. It goes ONLY here. Only the "updater" container receives it. Never paste it into the
# web UI, a chat, a ticket, or git. If it ever leaks, revoke it at abuse.ch and create a new one.
ABUSECH_AUTH_KEY=

# --- sandbox (optional; see docs/CAPE.md) -----------------------------------------------------------------
# TOLLGATE_CAPE_URL=https://cape.internal.example:8000
# TOLLGATE_CAPE_TOKEN=
# TOLLGATE_CAPE_TIMEOUT=120
# TOLLGATE_CAPE_OPTIONS=
# TOLLGATE_CAPE_VERIFY_TLS=1

# --- behind HTTPS / a reverse proxy (see docs/DEPLOYMENT.md) ----------------------------------------------
# TOLLGATE_COOKIE_SECURE=1
# TOLLGATE_TRUST_PROXY=1

# --- use a prebuilt or offline-loaded image instead of building ---------------------------------------------
# TOLLGATE_IMAGE=ghcr.io/teddy-williams/tollgate-defender:0.4.0
